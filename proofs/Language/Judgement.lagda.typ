module Language.Judgement where

open import Prelude

open import Language.Context
open import Language.Syntax

infix  2  _⊢_∙_∶_⊣_  _⊩_∥_∙_∶_⊣_

data _⊢_∙_∶_⊣_ : Context → Quantity → Expression → Type → Context → Set
data _⊩_∥_∙_∶_⊣_ : Context → (n : ℕ) → Quantity ^ n → Expression ^ n → Type ^ n → Context → Set

data _⊢_∙_∶_⊣_ where
  ---- Lookup ----
  ⊢var : ∀{Γ₀ Γ₁ q x τ} →
    Γ₀ ∋ q ∙ x ∶ τ ↝ Γ₁ →
    ----------------------
    Γ₀ ⊢ q ∙ ` x ∶ τ ⊣ Γ₁
  -- ⊢var-1 : ∀{Γ x τ} →
  --   Γ ∋ 𝟏 ∙ x ∶ τ →
  --   ----------------------------
  --   Γ ⊢ 𝟏 ∙ x ∶ τ ⊣ Γ – 𝟏 ∙ x ∶ τ
  -- ⊢var-ε : ∀{Γ x τ} →
  --   Γ ∋ ε ∙ x ∶ τ →
  --   -----------------
  --   Γ ⊢ ε ∙ x ∶ τ ⊣ Γ
  -- ⊢var-ω : ∀{Γ x τ} →
  --   Γ ∋ ω ∙ x ∶ τ →
  --   -----------------
  --   Γ ⊢ ω ∙ x ∶ τ ⊣ Γ
  -- ⊢var-weak-1 : ∀{Γ x τ} →
  --   Γ ∋ ω ∙ x ∶ τ →
  --   -----------------
  --   Γ ⊢ 𝟏 ∙ x ∶ τ ⊣ Γ
  -- ⊢var-weak-ε : ∀{Γ x τ} →
  --   Γ ∋ ω ∙ x ∶ τ →
  --   -----------------
  --   Γ ⊢ ε ∙ x ∶ τ ⊣ Γ
  ---- Borrow ----
  ⊢borrow : ∀{Γ₀ q₀ e₀ τ₀ x* Γ₁} →
    ⌊ Γ₀ ⌋ x* ⊢ 𝟏 ∙ e₀ ∶ τ₀ ⊣ Γ₁ →
    -------------------------------------
    Γ₀ ⊢ q₀ ∙ [ x* ∣ e₀ ] ∶ τ₀ ⊣ ⌈ Γ₁ ⌉ x*
  ---- Bind ----
  ⊢let : ∀{Γ₀ Γ₁ Γ₂ q₀ x₀ e₀ τ₀ q e τ} →
    Γ₀ ⊢ q₀ ∙ e₀ ∶ τ₀ ⊣ Γ₁ →
    Γ₁ , q₀ ∙ x₀ ∶ τ₀ ⊢ q ∙ e ∶ τ ⊣ Γ₂ →
    ---------------------------------------------
    Γ₀ ⊢ q ∙ (val q₀ ∙ x₀ ＝ e₀ ⨾ e) ∶ τ ⊣ Γ₁ -- –¹ x₀ ?? Needed ??
  ---- Abstract ----
  ⊢abs-ε : ∀{Γ₀ Γ₁ n q∙x∶τⁿ e₀ τ₀ xⁿ} →
    Γ₀ / ε ∪ Γ₀ / ω ∪ⁿ n ∥ q∙x∶τⁿ ⊢ 𝟏 ∙ e₀ ∶ τ₀ ⊣ Γ₁ →
    --------------------------------------------------------------
    Γ₀ ⊢ ε ∙ fn[ q∙x∶τⁿ ] e₀ ∶ q∙x∶τⁿ ⟶ τ₀ ⊣ Γ₀ / 𝟏 ∪ Γ₁ –ⁿ n ∥ xⁿ
  ⊢abs-1 : ∀{Γ₀ Γ₁ n q∙x∶τⁿ e₀ τ₀ xⁿ} →
    Γ₀ / 𝟏 ∪ Γ₀ / ω ∪ⁿ n ∥ q∙x∶τⁿ ⊢ 𝟏 ∙ e₀ ∶ τ₀ ⊣ Γ₁ →
    -----------------------------------------------------------------------
    Γ₀ ⊢ 𝟏 ∙ fn[ q∙x∶τⁿ ] e₀ ∶ q∙x∶τⁿ ⟶ τ₀ ⊣ Γ₀ / ε ∪ Γ₁ –ⁿ n ∥ names q∙x∶τⁿ
  ⊢abs-ω : ∀{Γ₀ Γ₁ n q∙x∶τⁿ e₀ τ₀ xⁿ} →
    Γ₀ / ω ∪ⁿ n ∥ q∙x∶τⁿ ⊢ 𝟏 ∙ e₀ ∶ τ₀ ⊣ Γ₁ →
    --------------------------------------------------------------------------------
    Γ₀ ⊢ ω ∙ fn[ q∙x∶τⁿ ] e₀ ∶ q∙x∶τⁿ ⟶ τ₀ ⊣ Γ₀ / ε ∪ Γ₀ / 𝟏 ∪ Γ₁ –ⁿ n ∥ names q∙x∶τⁿ
  ---- Apply ----
  ⊢app-ε : ∀{Γ₀ Γ₁ Γₙ₊₁ e₀ τ₀ n eⁿ q∙x∶τⁿ qⁿ τⁿ} →
    Γ₀ ⊢ ε ∙ e₀ ∶ q∙x∶τⁿ ⟶ τ₀ ⊣ Γ₁ → -- use notation like `n × q∙x∶τⁿ`??
    Γ₁ ⊩ n ∥ qⁿ ∙ eⁿ ∶ τⁿ ⊣ Γₙ₊₁ →
    ----------------------------------------------------------------
    Γ₀ ⊢ ε ∙ e₀ [ eⁿ ] ∶ τ₀ ⊣ Γₙ₊₁
  ⊢app-1 : ∀{Γ₀ Γ₁ Γₙ₊₁ e₀ τ₀ n eⁿ q∙x∶τⁿ qⁿ τⁿ} →
    Γ₀ ⊢ ε ∙ e₀ ∶ q∙x∶τⁿ ⟶ τ₀ ⊣ Γ₁ → -- use notation like `n × q∙x∶τⁿ`??
    Γ₁ ⊩ n ∥ qⁿ ∙ eⁿ ∶ τⁿ ⊣ Γₙ₊₁ →
    ----------------------------------------------------------------
    Γ₀ ⊢ 𝟏 ∙ e₀ [ eⁿ ] ∶ τ₀ ⊣ Γₙ₊₁
  ⊢app-ω : ∀{Γ₀ Γ₁ Γₙ₊₁ e₀ τ₀ n eⁿ q∙x∶τⁿ qⁿ τⁿ} →
    Γ₀ ⊢ ε ∙ e₀ ∶ q∙x∶τⁿ ⟶ τ₀ ⊣ Γ₁ → -- use notation like `n × q∙x∶τⁿ`??
    Γ₁ ⊩ n ∥ qⁿ ∙ eⁿ ∶ τⁿ ⊣ Γₙ₊₁ → -- how to express `n × ∣ q ∣`??
    ----------------------------------------------------------------
    Γ₀ ⊢ ω ∙ e₀ [ eⁿ ] ∶ τ₀ ⊣ Γₙ₊₁

data _⊩_∥_∙_∶_⊣_ where
  ⊩empty : ∀{Γ₀} →
    -------------------------
    Γ₀ ⊩ 0 ∥ [] ∙ [] ∶ [] ⊣ Γ₀
  ⊩rest : ∀{Γ₀ Γ₁ Γₙ₊₁ n q₀ e₀ τ₀ τ₀' qⁿ eⁿ τⁿ} →
    Γ₀ ⊢ q₀ ∙ e₀ ∶ τ₀' ⊣ Γ₁ →
    τ₀' ≡ τ₀ →
    Γ₀ ∩ Γ₁ ⊩ n ∥ qⁿ ∙ eⁿ ∶ τⁿ ⊣ Γₙ₊₁ →
    -----------------------------------------------
    Γ₀ ⊩ suc n ∥ q₀ ∷ qⁿ ∙ e₀ ∷ eⁿ ∶ τ₀ ∷ τⁿ ⊣ Γₙ₊₁
```
